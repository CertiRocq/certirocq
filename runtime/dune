; The C runtime of the generated code. Its objects are linked by the plugin with the
; programs it compiles, so they are installed, with the sources and headers, in the
; runtime directory next to the CertiRocq.Plugin theory.

; gmp.h is needed by certirocq_gmp.c
(rule
 (targets gmp_cflags)
 (action
  (with-stdout-to
   %{targets}
   (system
    "pkg-config --cflags gmp 2>/dev/null || (test -d /opt/homebrew/include && echo -I/opt/homebrew/include) || true"))))

(rule
 (targets gc_stack.o)
 (deps gc_stack.c (glob_files *.h) gmp_cflags)
 (action
  (system
   "%{cc} $(cat gmp_cflags) -I . -I %{ocaml_where} -fPIC -O2 -g -c -o %{targets} gc_stack.c")))

(rule
 (targets certirocq_run_main.o)
 (deps certirocq_run_main.c (glob_files *.h) gmp_cflags)
 (action
  (system
   "%{cc} $(cat gmp_cflags) -I . -I %{ocaml_where} -fPIC -O2 -g -c -o %{targets} certirocq_run_main.c")))

(rule
 (targets rocq_c_ffi.o)
 (deps rocq_c_ffi.c (glob_files *.h) gmp_cflags)
 (action
  (system
   "%{cc} $(cat gmp_cflags) -I . -I %{ocaml_where} -fPIC -O2 -g -c -o %{targets} rocq_c_ffi.c")))

(rule
 (targets rocq_ffi.o)
 (deps rocq_ffi.c (glob_files *.h) gmp_cflags)
 (action
  (system
   "%{cc} $(cat gmp_cflags) -I . -I %{ocaml_where} -fPIC -O2 -g -c -o %{targets} rocq_ffi.c")))

(rule
 (targets prim_int63.o)
