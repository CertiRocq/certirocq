opam-version: "2.0"
version: "dev"
maintainer: "The CertiRocq Team"
homepage: "https://certirocq.org/"
dev-repo: "git+https://github.com/CertiRocq/certirocq"
bug-reports: "https://github.com/CertiRocq/certirocq/issues"
authors: ["Andrew Appel"
          "Yannick Forster"
          "Anvay Grover"
          "Joomy Korkut"
          "John Li"
          "Zoe Paraskevopoulou"
          "Matthieu Sozeau"
          "Matthew Weaver"
          "Abhishek Anand"
          "Greg Morrisett"
          "Randy Pollack"
          "Olivier Savary Belanger"
  ]
license: "MIT"
build: [
  ["dune" "subst"] {dev}
  ["dune" "build" "-p" name "-j" jobs]
]
depends: [
  "ocaml" {>= "4.13"}
  "dune" {>= "3.23"}
  "conf-clang"
  "conf-gmp"
  "stdlib-shims"
  "rocq-core" {= "dev"}
  "rocq-stdlib" {= "dev"}
  "coq-compcert" {= "dev"}
  "rocq-equations" {= "dev"}
  "rocq-metarocq-erasure" {= "dev"}
  "rocq-metarocq-safechecker" {= "dev"}
  "coq-ext-lib" {= "dev"}
  "coq-wasm" {= "dev"}
]

synopsis: "A Verified Compiler for Gallina, Written in Gallina"
url {
  git: "https://github.com/CertiRocq/certirocq.git"
}
