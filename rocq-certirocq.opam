opam-version: "2.0"
version: "dev+9.0"
maintainer: "The CertiRocq Team"
homepage: "https://certirocq.org/"
dev-repo: "git+https://github.com/CertiRocq/certirocq"
bug-reports: "https://github.com/CertiRocq/certirocq/issues"
authors: ["Andrew Appel"
          "Yannick Forster"
          "Anvay Grover"
          "Joomy Korkut"
          "John Li"
          "Zoe Paraskevopoulou"
          "Matthieu Sozeau"
          "Matthew Weaver"
          "Abhishek Anand"
          "Greg Morrisett"
          "Randy Pollack"
          "Olivier Savary Belanger"
  ]
license: "MIT"
build: [
  ["bash" "./configure.sh"]
  [make "all"]
  [make "plugins"]
  [make "bootstrap"]
]
install: [
  [make "install"]
]
depends: [
  "ocaml" {>= "4.13"}
  "conf-clang"
  "stdlib-shims"
  "coq" {>= "9.1" & < "9.2~"}
  "coq-compcert" {= "3.17"}
  "rocq-equations" {= "1.3.1+9.1"}
  "rocq-metarocq-erasure-plugin" {>= "1.5.1"}
  "rocq-metarocq-safechecker-plugin" {>= "1.5.1"}
  "coq-ext-lib" {>= "0.12"}
  "coq-wasm" {>= "2.2.1"}
  "rocq-vellvm" {> "3.0.20260707"}
]
# The LLVM backend (theories/CodegenLLVM) needs Vellvm's current AST
# (CONV_Impure), which no Vellvm release contains yet. This pin, the
# vellvm/ submodule and .nix/coq-overlays/vellvm name the same commit;
# replace them by a version constraint once Vellvm tags a release that
# includes it.
pin-depends: [
  ["rocq-vellvm.dev" "git+https://github.com/vellvm/vellvm.git#b63a28a0a36cbae73a454d99a97bb8171568343e"]
]

synopsis: "A Verified Compiler for Gallina, Written in Gallina "
url {
  git: "https://github.com/CertiRocq/certirocq.git"
}
