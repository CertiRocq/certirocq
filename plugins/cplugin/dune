(copy_files# static/*.{ml,mli})

(copy_files# ../common/*.{ml,mli})

; The commands are shared by both plugins, which set their name with cpp
(rule
 (targets g_certirocq_vanilla.mlg)
 (deps g_certirocq_vanilla.mlg.in ../common/certirocq_commands.mlg)
 (action
  (with-stdout-to
   %{targets}
   (run cpp -traditional-cpp -P g_certirocq_vanilla.mlg.in))))

(rocq.pp
 (modules g_certirocq_vanilla))

(copy_files# ../../runtime/get_ordinal.c)

(library
 (name certirocq_vanilla_plugin)
 (public_name rocq-certirocq-vanilla.plugin)
 (flags (:standard -rectypes -w +a-4-8-9-20-26-27-32..34-37-39-41-42-44-45-48-56-58-60-67-68-70 -warn-error -a))
 (libraries
  rocq-runtime.plugins.ltac
  rocq-metarocq-template.extractable
  stdlib-shims
  unix)
 (foreign_stubs
  (language c)
  (names get_ordinal)
  (include_dirs ../../runtime)))

